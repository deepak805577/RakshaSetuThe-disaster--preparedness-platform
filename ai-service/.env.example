# AI Service Configuration

# Server Configuration
AI_PORT=5001
FLASK_ENV=development
SECRET_KEY=ai-disaster-app-secret-key-change-in-production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/disaster-ai
REDIS_URL=redis://localhost:6379/0

# API Keys
IMD_API_KEY=your-imd-api-key-here
OPENWEATHER_API_KEY=your-openweather-api-key-here
SATELLITE_API_KEY=your-satellite-imagery-api-key-here

# TensorFlow Configuration
TF_CPP_MIN_LOG_LEVEL=2
CUDA_VISIBLE_DEVICES=0

# Model Configuration
MODEL_UPDATE_INTERVAL=86400  # 24 hours in seconds
PREDICTION_CACHE_TTL=3600    # 1 hour in seconds

# Computer Vision Configuration
MAX_IMAGE_SIZE=4194304       # 4MB max image size
SUPPORTED_FORMATS=jpg,jpeg,png,bmp

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/ai-service.log

# Performance Configuration
MAX_WORKERS=4
TIMEOUT_SECONDS=30
BATCH_SIZE=32

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
RATE_LIMIT_PER_MINUTE=60
